<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <add name="InventoryDB" connectionString="Server=.\SQLEXPRESS;Database=Inventory;Trusted_Connection=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
    </connectionStrings>

    <!--
      MIOS performs its own DPI-aware layout scaling in ModernTheme, so
      WinForms' automatic high-DPI resizing is turned off to avoid
      double-scaling the code-built controls.
    -->
    <System.Windows.Forms.ApplicationConfigurationSection>
        <add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />
    </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
